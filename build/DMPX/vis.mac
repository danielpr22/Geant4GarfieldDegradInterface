####################################
############ Initial setup #########
####################################

# Setting the gas pressure at 1 bar
/DMPX/geometry/SetGasPressure 1. bar

# The HeedDeltaElectron model simulates the transport and ionization of low-energy electrons and photons
/gasModelParameters/heed/heeddeltaelectron/addparticle e- 0. 0.001
/gasModelParameters/heed/heeddeltaelectron/addparticle gamma 0. 10000000

# The HeedNewTrack model simulates the primary ionization caused by charged particles entering a gas volume.
/gasModelParameters/heed/heednewtrack/addparticle e- 0.1 100000.

# Setting the gasModelParameters 
/gasModelParameters/heed/drift 1
/gasModelParameters/heed/driftRKF 0
/gasModelParameters/heed/trackmicroscopic 0
/gasModelParameters/heed/createAval 1
/gasModelParameters/heed/visualizechamber 1
/gasModelParameters/heed/visualizesignals 0
/gasModelParameters/heed/visualizefield 1
/gasModelParameters/heed/voltageplanehv -100000
/gasModelParameters/heed/voltageplanelow 0
/gasModelParameters/heed/voltageanodewire 1500.
/gasModelParameters/heed/voltagecathodewire 0.
/gasModelParameters/heed/voltagegate -70.
/gasModelParameters/heed/voltagedeltagate 90.

/run/numberOfThreads 1
/control/cout/ignoreThreadsExcept 0
/DMPX/phys/setLowLimitE 1. keV
/DMPX/phys/InitializePhysics emlivermore
/DMPX/phys/AddParametrisation
/process/em/AddPAIRegion all RegionGasBox PAIphoton

/run/initialize

####################################
############ Verbosities ###########
####################################

/tracking/verbose 0
/run/verbose 1
/event/verbose 1
/vis/verbose 6

####################################
########### Visualization ##########
####################################

/vis/open OGL 600x600-0+0
/vis/drawVolume
/vis/scene/add/axes 0 0 0 10 cm

/vis/scene/add/trajectories smooth
/vis/scene/add/hits

/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/set -1 green
/vis/modeling/trajectories/drawByCharge-0/set +1 yellow
/vis/modeling/trajectories/drawByCharge-0/verbose 1


/vis/scene/endOfEventAction accumulate 100

gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/centre -21. 0.9 -31.27 mm
/gps/pos/halfx 17.5 mm
/gps/pos/halfy 1.0 mm

/gps/direction 0. 1. 0.
/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 10 keV


####################################




# Draw smooth trajectories at end of event
# Gamma-rays represented in red.


# When running an event, accumulate N events (in this case, 100) for visualization




#/run/beamOn 10